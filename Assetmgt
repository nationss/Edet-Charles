
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edet Charles — Portfolio Asset Manager</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#D4A843;--gold-light:#F0C455;--gold-dim:#8B6914;
  --gold-glow:rgba(212,168,67,0.25);--gold-glow-strong:rgba(212,168,67,0.5);
  --black:#050505;--black-2:#0C0C0C;--black-3:#111111;--black-4:#181818;
  --white:#FAFAFA;--white-dim:rgba(250,250,250,0.7);--white-faint:rgba(250,250,250,0.12);
  --glass:rgba(255,255,255,0.04);--glass-border:rgba(212,168,67,0.18);
  --green:#4ade80;--red:#f87171;--radius:18px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif;min-height:100vh}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:var(--black)}::-webkit-scrollbar-thumb{background:var(--gold-dim);border-radius:2px}

/* HEADER */
.am-header{background:rgba(5,5,5,.95);border-bottom:1px solid rgba(212,168,67,.15);padding:0 48px;height:72px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;backdrop-filter:blur(20px)}
.am-logo{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;letter-spacing:.1em;background:linear-gradient(135deg,var(--gold-light),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.am-header-sub{font-size:.72rem;color:var(--white-dim);letter-spacing:.1em;text-transform:uppercase}
.am-header-right{display:flex;align-items:center;gap:16px}
.am-badge{padding:6px 14px;border-radius:50px;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.3);font-size:.7rem;color:var(--green);letter-spacing:.08em;display:flex;align-items:center;gap:6px}
.am-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 6px rgba(74,222,128,.6);flex-shrink:0}

/* LAYOUT */
.am-main{max-width:1200px;margin:0 auto;padding:40px 24px 80px}
.am-section{margin-bottom:60px}
.am-section-title{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;letter-spacing:.06em;margin-bottom:6px}
.am-section-sub{font-size:.82rem;color:var(--white-dim);margin-bottom:28px;line-height:1.6}
.gold-line{width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--gold-dim),transparent);margin:50px 0}

/* ALERT BOX */
.alert-box{padding:18px 24px;border-radius:16px;background:rgba(212,168,67,.06);border:1px solid rgba(212,168,67,.25);margin-bottom:36px;display:flex;gap:14px;align-items:flex-start}
.alert-box .ai{font-size:1.3rem;flex-shrink:0;margin-top:2px}
.alert-box .at{font-size:.85rem;color:var(--white-dim);line-height:1.7}
.alert-box .at strong{color:var(--gold);display:block;margin-bottom:4px;font-size:.9rem}

/* UPLOAD ZONE */
.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.upload-card{border-radius:var(--radius);background:var(--glass);border:1.5px dashed var(--glass-border);padding:32px;transition:all .3s;position:relative;overflow:hidden}
.upload-card:hover{border-color:var(--gold-dim);background:rgba(212,168,67,.03)}
.upload-card.has-file{border-style:solid;border-color:var(--gold-dim);background:rgba(212,168,67,.04)}
.upload-card.full-width{grid-column:1/-1}
.upload-card-header{display:flex;align-items:center;gap:14px;margin-bottom:20px}
.upload-icon{width:48px;height:48px;border-radius:14px;background:var(--gold-glow);border:1px solid var(--gold-dim);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0}
.upload-card-header h3{font-size:1rem;font-weight:700;margin-bottom:3px}
.upload-card-header p{font-size:.75rem;color:var(--white-dim)}
.upload-zone{border:1.5px dashed rgba(212,168,67,.2);border-radius:14px;padding:28px 20px;text-align:center;cursor:pointer;transition:all .3s;background:rgba(255,255,255,.02)}
.upload-zone:hover,.upload-zone.drag-over{border-color:var(--gold);background:rgba(212,168,67,.06)}
.upload-zone input[type=file]{display:none}
.upload-zone-icon{font-size:2rem;margin-bottom:10px;opacity:.5}
.upload-zone p{font-size:.82rem;color:var(--white-dim);margin-bottom:6px}
.upload-zone .uz-formats{font-size:.7rem;color:rgba(255,255,255,.3);letter-spacing:.06em;text-transform:uppercase}
.upload-zone label{display:flex;flex-direction:column;align-items:center;cursor:pointer;width:100%}
.upload-btn-inline{margin-top:14px;padding:9px 22px;border-radius:50px;background:var(--gold-glow);border:1px solid var(--gold-dim);color:var(--gold);font-size:.75rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:all .25s;display:inline-flex;align-items:center;gap:6px}
.upload-btn-inline:hover{background:rgba(212,168,67,.2);border-color:var(--gold)}

/* PREVIEW AREA */
.preview-area{margin-top:18px;display:none}
.preview-area.visible{display:block}
.preview-img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;border:1px solid var(--glass-border)}
.preview-img.portrait{aspect-ratio:3/4}
.preview-pdf-card{padding:18px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid var(--glass-border);display:flex;align-items:center;gap:14px}
.preview-pdf-icon{font-size:1.8rem;flex-shrink:0}
.preview-pdf-info .pfn{font-size:.9rem;font-weight:600;margin-bottom:3px;word-break:break-all}
.preview-pdf-info .pfs{font-size:.72rem;color:var(--white-dim)}
.preview-actions{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.prev-btn{padding:8px 18px;border-radius:50px;font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:all .25s;text-decoration:none;display:inline-flex;align-items:center;gap:6px;border:none}
.prev-btn-gold{background:linear-gradient(135deg,var(--gold-light),var(--gold));color:#000}
.prev-btn-gold:hover{box-shadow:0 0 20px var(--gold-glow);transform:translateY(-1px)}
.prev-btn-outline{background:transparent;color:var(--gold);border:1.5px solid var(--gold-dim)}
.prev-btn-outline:hover{background:var(--gold-glow)}
.prev-btn-red{background:transparent;color:var(--red);border:1.5px solid rgba(248,113,113,.3)}
.prev-btn-red:hover{background:rgba(248,113,113,.1)}
.file-status{display:flex;align-items:center;gap:7px;font-size:.75rem;padding:7px 14px;border-radius:50px;margin-top:12px;width:fit-content}
.file-status.ok{background:rgba(74,222,128,.08);border:1px solid rgba(74,222,128,.25);color:var(--green)}
.file-status.ok::before{content:'✓';font-weight:700}
.file-status.warn{background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.25);color:var(--gold)}
.file-status.warn::before{content:'⚠'}

/* PORTFOLIO DOCS GRID */
.doc-upload-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:24px}
.doc-slot{border-radius:14px;background:var(--glass);border:1.5px dashed var(--glass-border);padding:20px;transition:all .3s;text-align:center}
.doc-slot:hover{border-color:var(--gold-dim)}
.doc-slot.filled{border-style:solid;border-color:rgba(212,168,67,.3)}
.doc-slot-icon{font-size:1.6rem;margin-bottom:10px}
.doc-slot h4{font-size:.85rem;font-weight:600;margin-bottom:6px}
.doc-slot p{font-size:.72rem;color:var(--white-dim);margin-bottom:14px;line-height:1.5}
.doc-slot label{cursor:pointer}
.doc-slot input[type=file]{display:none}
.doc-add-btn{padding:7px 16px;border-radius:50px;background:var(--gold-glow);border:1px solid var(--gold-dim);color:var(--gold);font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:5px}
.doc-add-btn:hover{background:rgba(212,168,67,.2)}

/* LIVE PREVIEW PANEL */
.live-preview-panel{border-radius:var(--radius);background:var(--black-3);border:1px solid var(--glass-border);overflow:hidden}
.lp-header{padding:20px 28px;border-bottom:1px solid rgba(255,255,255,.05);display:flex;align-items:center;justify-content:space-between}
.lp-header h3{font-size:.9rem;font-weight:700}
.lp-badge{padding:5px 12px;border-radius:50px;background:rgba(212,168,67,.1);border:1px solid var(--gold-dim);font-size:.66rem;color:var(--gold);letter-spacing:.08em;text-transform:uppercase}
.lp-body{padding:28px}

/* VISITOR CV CARD */
.cv-visitor-card{border-radius:20px;background:linear-gradient(135deg,#1a1208 0%,#111 50%,#0f0f0f 100%);border:1px solid var(--gold-dim);padding:28px;display:flex;gap:20px;align-items:center;box-shadow:0 0 40px rgba(212,168,67,.08)}
.cv-visitor-photo{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--gold-dim),var(--black-4));border:2px solid var(--gold);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.8rem}
.cv-visitor-photo img{width:100%;height:100%;object-fit:cover}
.cv-visitor-info h3{font-size:1.1rem;font-weight:700;margin-bottom:3px}
.cv-visitor-info .role{font-size:.78rem;color:var(--gold);letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}
.cv-visitor-info p{font-size:.78rem;color:var(--white-dim);line-height:1.5;margin-bottom:14px}
.cv-visitor-btns{display:flex;gap:10px;flex-wrap:wrap}

/* INSTRUCTIONS */
.instructions-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.inst-card{padding:24px;border-radius:var(--radius);background:var(--glass);border:1px solid var(--glass-border)}
.inst-num{font-family:'Bebas Neue',sans-serif;font-size:2.5rem;color:rgba(212,168,67,.2);line-height:1;margin-bottom:10px}
.inst-card h4{font-size:.95rem;font-weight:700;margin-bottom:8px}
.inst-card p{font-size:.8rem;color:var(--white-dim);line-height:1.65}
.inst-card ul{padding-left:16px;margin-top:8px}
.inst-card ul li{font-size:.78rem;color:var(--white-dim);line-height:1.7}

/* SUMMARY TABLE */
.summary-table{width:100%;border-collapse:collapse}
.summary-table th{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);padding:10px 16px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)}
.summary-table td{padding:14px 16px;font-size:.82rem;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
.summary-table tr:hover td{background:rgba(255,255,255,.02)}
.status-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:8px}
.status-dot.ok{background:var(--green);box-shadow:0 0 6px rgba(74,222,128,.5)}
.status-dot.missing{background:rgba(255,255,255,.2)}
.status-dot.pending{background:var(--gold);box-shadow:0 0 6px var(--gold-glow)}

/* RESPONSIVE */
@media(max-width:900px){.upload-grid{grid-template-columns:1fr}.doc-upload-grid{grid-template-columns:1fr 1fr}.instructions-grid{grid-template-columns:1fr}}
@media(max-width:640px){.am-header{padding:0 18px}.am-main{padding:24px 14px 60px}.doc-upload-grid{grid-template-columns:1fr}.cv-visitor-card{flex-direction:column;text-align:center}.cv-visitor-btns{justify-content:center}}
</style>
</head>
<body>

<!-- HEADER -->
<div class="am-header">
  <div>
    <div class="am-logo">Edet Charles — Asset Manager</div>
    <div class="am-header-sub">Portfolio Files & Documents Control Panel</div>
  </div>
  <div class="am-header-right">
    <div class="am-badge">Admin Panel</div>
    <a href="portfolio.html" style="padding:8px 18px;border-radius:50px;background:var(--gold-glow);border:1px solid var(--gold-dim);color:var(--gold);font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:all .25s;" onmouseover="this.style.background='rgba(212,168,67,.2)'" onmouseout="this.style.background='var(--gold-glow)'">← View Portfolio</a>
  </div>
</div>

<div class="am-main">

  <!-- ALERT -->
  <div class="alert-box">
    <div class="ai">💡</div>
    <div class="at">
      <strong>How This Works</strong>
      Use this page to upload your photo, CV, and all portfolio documents. Files are loaded directly in your browser — nothing is sent to any server. Once uploaded, this page shows you exactly how visitors will see and download your files. <strong>Keep this file (assets-manager.html) alongside your portfolio.html</strong> — they work together.
    </div>
  </div>

  <!-- ── SECTION 1: PROFILE PHOTO ── -->
  <div class="am-section">
    <div class="am-section-title">📸 Profile Photo</div>
    <div class="am-section-sub">Upload your professional photo. This will appear in the Hero section of your portfolio. Recommended: square or portrait orientation, min. 600×800px, JPG or PNG.</div>

    <div class="upload-grid">
      <div class="upload-card" id="photoCard">
        <div class="upload-card-header">
          <div class="upload-icon">🖼️</div>
          <div>
            <h3>Profile Photo</h3>
            <p>Your main portfolio photo (Hero & About sections)</p>
          </div>
        </div>
        <div class="upload-zone" id="photoZone">
          <label for="photoInput">
            <div class="upload-zone-icon">📷</div>
            <p>Drag & drop your photo here, or click to browse</p>
            <div class="uz-formats">JPG · PNG · WEBP · Max 10MB</div>
            <div class="upload-btn-inline">📁 Choose Photo</div>
          </label>
          <input type="file" id="photoInput" accept="image/*">
        </div>
        <div class="preview-area" id="photoPreview">
          <img class="preview-img portrait" id="photoPreviewImg" src="" alt="Profile photo preview">
          <div class="file-status ok" id="photoStatus">Photo loaded successfully</div>
          <div class="preview-actions">
            <button class="prev-btn prev-btn-red" onclick="clearFile('photo')">✕ Remove</button>
          </div>
        </div>
      </div>

      <!-- VISITOR PREVIEW -->
      <div class="upload-card">
        <div class="upload-card-header">
          <div class="upload-icon">👁️</div>
          <div>
            <h3>Visitor Preview</h3>
            <p>How your photo appears on the portfolio</p>
          </div>
        </div>
        <div class="live-preview-panel">
          <div class="lp-header">
            <h3>Hero Section Preview</h3>
            <div class="lp-badge">Live Preview</div>
          </div>
          <div class="lp-body">
            <div style="width:160px;height:200px;border-radius:20px;overflow:hidden;border:1px solid var(--glass-border);margin:0 auto;background:linear-gradient(135deg,#1a1a1a,#1e1a0e);display:flex;align-items:center;justify-content:center;position:relative;">
              <img id="heroPhotoPreview" src="" style="width:100%;height:100%;object-fit:cover;display:none;object-position:top">
              <div id="heroPPhotoPlaceholder" style="text-align:center;color:var(--white-dim);">
                <div style="font-size:2rem;margin-bottom:8px;opacity:.3">👤</div>
                <div style="font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;opacity:.4">Your Photo</div>
              </div>
            </div>
            <p style="text-align:center;font-size:.72rem;color:var(--white-dim);margin-top:12px;">Upload photo to see it here</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="gold-line"></div>

  <!-- ── SECTION 2: CV / RESUME ── -->
  <div class="am-section">
    <div class="am-section-title">📄 CV / Resume</div>
    <div class="am-section-sub">Upload your CV as a PDF. Visitors can preview it in their browser or download it with a single click. The "Download CV" button throughout your portfolio links to this file.</div>

    <div class="upload-grid">
      <div class="upload-card" id="cvCard">
        <div class="upload-card-header">
          <div class="upload-icon">📋</div>
          <div>
            <h3>CV / Resume File</h3>
            <p>PDF format recommended for universal compatibility</p>
          </div>
        </div>
        <div class="upload-zone" id="cvZone">
          <label for="cvInput">
            <div class="upload-zone-icon">📄</div>
            <p>Drag & drop your CV here, or click to browse</p>
            <div class="uz-formats">PDF recommended · Max 10MB</div>
            <div class="upload-btn-inline">📁 Choose CV File</div>
          </label>
          <input type="file" id="cvInput" accept=".pdf,.doc,.docx">
        </div>
        <div class="preview-area" id="cvPreview">
          <div class="preview-pdf-card">
            <div class="preview-pdf-icon">📋</div>
            <div class="preview-pdf-info">
              <div class="pfn" id="cvFileName">EDET_CHARLES_UKI_CV.pdf</div>
              <div class="pfs" id="cvFileSize">File size will show here</div>
            </div>
          </div>
          <div class="file-status ok" id="cvStatus">CV loaded — ready for download</div>
          <div class="preview-actions">
            <a class="prev-btn prev-btn-gold" id="cvPreviewBtn" href="#" target="_blank">👁 Preview CV</a>
            <a class="prev-btn prev-btn-outline" id="cvDownloadBtn" href="#" download="EDET_CHARLES_UKI_CV.pdf">↓ Download CV</a>
            <button class="prev-btn prev-btn-red" onclick="clearFile('cv')">✕ Remove</button>
          </div>
        </div>
      </div>

      <!-- VISITOR CV CARD PREVIEW -->
      <div class="upload-card">
        <div class="upload-card-header">
          <div class="upload-icon">👁️</div>
          <div>
            <h3>Visitor Experience</h3>
            <p>What visitors see when they click "Download CV"</p>
          </div>
        </div>
        <div style="margin-bottom:14px;">
          <div class="cv-visitor-card">
            <div class="cv-visitor-photo" id="cvCardPhoto">
              <img id="cvCardPhotoImg" src="" style="display:none;width:100%;height:100%;object-fit:cover;">
              <span id="cvCardPhotoPlaceholder">👤</span>
            </div>
            <div class="cv-visitor-info">
              <h3>Edet Charles Uki</h3>
              <div class="role">Data Analyst · Inventory Specialist</div>
              <p>Lagos, Nigeria · edetcharles46@gmail.com<br>Open to Freelance & Remote Work</p>
              <div class="cv-visitor-btns">
                <a class="prev-btn prev-btn-gold" id="visitorCvPreview" href="#" target="_blank" style="pointer-events:none;opacity:.5">👁 Preview CV</a>
                <a class="prev-btn prev-btn-outline" id="visitorCvDownload" href="#" download="EDET_CHARLES_UKI_CV.pdf" style="pointer-events:none;opacity:.5">↓ Download CV</a>
              </div>
            </div>
          </div>
          <p style="font-size:.7rem;color:var(--white-dim);margin-top:12px;text-align:center;">↑ This is exactly what visitors see on your portfolio</p>
        </div>
      </div>
    </div>
  </div>

  <div class="gold-line"></div>

  <!-- ── SECTION 3: PORTFOLIO DOCUMENTS ── -->
  <div class="am-section">
    <div class="am-section-title">📁 Portfolio Project Files</div>
    <div class="am-section-sub">Upload screenshots, documents, or PDFs for each of your portfolio projects. These appear when visitors click on a project card. Supports images, PDFs, and spreadsheets.</div>

    <div class="doc-upload-grid" id="docGrid">

      <div class="doc-slot" id="doc-slot-0">
        <div class="doc-slot-icon">📊</div>
        <h4>Sales Performance Analysis</h4>
        <p>Data Analysis · Excel · Power BI</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 0)"><div class="doc-add-btn">+ Upload File</div></label>
        <div style="margin-top:10px;display:none" id="doc-preview-0"></div>
      </div>

      <div class="doc-slot" id="doc-slot-1">
        <div class="doc-slot-icon">🏥</div>
        <h4>Hospital Finance Dashboard</h4>
        <p>Power BI · Healthcare Finance</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 1)"><div class="doc-add-btn">+ Upload File</div></label>
        <div style="margin-top:10px;display:none" id="doc-preview-1"></div>
      </div>

      <div class="doc-slot" id="doc-slot-2">
        <div class="doc-slot-icon">📦</div>
        <h4>Warehouse Inventory System</h4>
        <p>Excel · Stock Control · Automation</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 2)"><div class="doc-add-btn">+ Upload File</div></label>
        <div style="margin-top:10px;display:none" id="doc-preview-2"></div>
      </div>

      <div class="doc-slot" id="doc-slot-3">
        <div class="doc-slot-icon">💰</div>
        <h4>Monthly Financial Report</h4>
        <p>Accounting · QuickBooks · Reporting</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 3)"><div class="doc-add-btn">+ Upload File</div></label>
        <div style="margin-top:10px;display:none" id="doc-preview-3"></div>
      </div>

      <div class="doc-slot" id="doc-slot-4">
        <div class="doc-slot-icon">🔍</div>
        <h4>Audit Working Papers</h4>
        <p>Audit Documentation · Compliance</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 4)"><div class="doc-add-btn">+ Upload File</div></label>
        <div style="margin-top:10px;display:none" id="doc-preview-4"></div>
      </div>

      <div class="doc-slot" id="doc-slot-5">
        <div class="doc-slot-icon">🎨</div>
        <h4>Brand & Social Media Designs</h4>
        <p>Canva · CorelDRAW · Branding</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 5)"><div class="doc-add-btn">+ Upload File</div></label>
        <div style="margin-top:10px;display:none" id="doc-preview-5"></div>
      </div>

      <div class="doc-slot" id="doc-slot-6">
        <div class="doc-slot-icon">📐</div>
        <h4>OAF Foundation Budget Tracker</h4>
        <p>Excel · NGO Finance · Budgeting</p>
        <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, 6)"><div class="doc-add-btn">+ Upload File</div></label>
