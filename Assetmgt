      <div class="ai">⚠️</div>
      <div class="at">
        <strong>Important: Files Are Session-Based</strong>
        Files uploaded here exist only while this page is open in your browser. For a permanent solution, <strong>host your portfolio on a web platform like GitHub Pages, Netlify, or Vercel</strong> and place your actual files (photo.jpg, cv.pdf) in the same folder as portfolio.html. Then update the src and href references in portfolio.html to point to those real file names. I can help you set that up if needed.
      </div>
    </div>
  </div>

</div><!-- end am-main -->

<script>
// ── PHOTO UPLOAD ──
const photoInput = document.getElementById('photoInput');
photoInput.addEventListener('change', function() {
  if (!this.files[0]) return;
  const url = URL.createObjectURL(this.files[0]);
  document.getElementById('photoPreviewImg').src = url;
  document.getElementById('photoPreview').classList.add('visible');
  document.getElementById('heroPhotoPreview').src = url;
  document.getElementById('heroPhotoPreview').style.display = 'block';
  document.getElementById('heroPPhotoPlaceholder').style.display = 'none';
  document.getElementById('cvCardPhotoImg').src = url;
  document.getElementById('cvCardPhotoImg').style.display = 'block';
  document.getElementById('cvCardPhotoPlaceholder').style.display = 'none';
  document.getElementById('photoCard').classList.add('has-file');
  document.getElementById('photoStatus').textContent = this.files[0].name + ' — Ready';
  updateStatus('photo', true, this.files[0].name);
});

// ── CV UPLOAD ──
const cvInput = document.getElementById('cvInput');
cvInput.addEventListener('change', function() {
  if (!this.files[0]) return;
  const file = this.files[0];
  const url = URL.createObjectURL(file);
  const sizeMB = (file.size / 1048576).toFixed(2);
  document.getElementById('cvFileName').textContent = file.name;
  document.getElementById('cvFileSize').textContent = sizeMB + ' MB · ' + file.type;
  document.getElementById('cvPreview').classList.add('visible');
  document.getElementById('cvCard').classList.add('has-file');
  document.getElementById('cvPreviewBtn').href = url;
  document.getElementById('cvDownloadBtn').href = url;
  document.getElementById('cvDownloadBtn').download = file.name;
  document.getElementById('visitorCvPreview').href = url;
  document.getElementById('visitorCvPreview').style.opacity = '1';
  document.getElementById('visitorCvPreview').style.pointerEvents = 'auto';
  document.getElementById('visitorCvDownload').href = url;
  document.getElementById('visitorCvDownload').download = file.name;
  document.getElementById('visitorCvDownload').style.opacity = '1';
  document.getElementById('visitorCvDownload').style.pointerEvents = 'auto';
  updateStatus('cv', true, file.name);
});

// ── AWARD UPLOAD ──
function loadAward(input) {
  if (!input.files[0]) return;
  const url = URL.createObjectURL(input.files[0]);
  document.getElementById('awardPreviewImg').src = url;
  document.getElementById('awardPreview').classList.add('visible');
}

// ── DOC SLOT UPLOAD ──
function loadDocFile(input, index) {
  if (!input.files[0]) return;
  const file = input.files[0];
  const url = URL.createObjectURL(file);
  const prevDiv = document.getElementById('doc-preview-' + index);
  const slot = document.getElementById('doc-slot-' + index);
  prevDiv.style.display = 'block';
  slot.classList.add('filled');
  if (file.type.startsWith('image/')) {
    prevDiv.innerHTML = `<img src="${url}" style="width:100%;border-radius:8px;aspect-ratio:16/9;object-fit:cover;border:1px solid var(--glass-border);">
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
        <a href="${url}" target="_blank" class="doc-add-btn" style="font-size:.62rem;padding:5px 12px;">👁 View</a>
        <a href="${url}" download="${file.name}" class="doc-add-btn" style="font-size:.62px;padding:5px 12px;">↓ Download</a>
      </div>`;
  } else {
    prevDiv.innerHTML = `<div style="padding:10px;border-radius:8px;background:rgba(255,255,255,.04);border:1px solid var(--glass-border);font-size:.75rem;">
      📄 ${file.name}<br><span style="color:var(--gold);font-size:.68rem;">${(file.size/1048576).toFixed(2)} MB</span>
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
        <a href="${url}" target="_blank" class="doc-add-btn" style="font-size:.62rem;padding:5px 12px;">👁 Preview</a>
        <a href="${url}" download="${file.name}" class="doc-add-btn" style="font-size:.62rem;padding:5px 12px;">↓ Download</a>
      </div></div>`;
  }
  updateStatus('doc-' + index, true, file.name);
}

// ── CERT UPLOAD ──
function loadCert(input, index) {
  if (!input.files[0]) return;
  const file = input.files[0];
  const url = URL.createObjectURL(file);
  const prevDiv = document.getElementById('cert-preview-' + index);
  prevDiv.style.display = 'block';
  if (file.type.startsWith('image/')) {
    prevDiv.innerHTML = `<img src="${url}" style="width:100%;border-radius:8px;border:1px solid var(--glass-border);">`;
  } else {
    prevDiv.innerHTML = `<div style="font-size:.72rem;padding:8px;background:rgba(255,255,255,.04);border-radius:8px;">📄 ${file.name}<br><a href="${url}" target="_blank" style="color:var(--gold);font-size:.68rem;">Preview</a></div>`;
  }
}

// ── ADD NEW DOC SLOT ──
let docSlotCount = 9;
function addNewDocSlot() {
  const grid = document.getElementById('docGrid');
  const slot = document.createElement('div');
  slot.className = 'doc-slot';
  slot.id = 'doc-slot-' + docSlotCount;
  slot.innerHTML = `
    <div class="doc-slot-icon">📁</div>
    <h4>New Project ${docSlotCount + 1}</h4>
    <p>Upload your project file or screenshot</p>
    <label><input type="file" accept="image/*,.pdf" onchange="loadDocFile(this, ${docSlotCount})"><div class="doc-add-btn">+ Upload File</div></label>
    <div style="margin-top:10px;display:none" id="doc-preview-${docSlotCount}"></div>`;
  grid.appendChild(slot);
  slot.scrollIntoView({ behavior: 'smooth', block: 'center' });
  docSlotCount++;
}

// ── CLEAR FILE ──
function clearFile(type) {
  if (type === 'photo') {
    document.getElementById('photoInput').value = '';
    document.getElementById('photoPreview').classList.remove('visible');
    document.getElementById('photoCard').classList.remove('has-file');
    document.getElementById('heroPhotoPreview').style.display = 'none';
    document.getElementById('heroPPhotoPlaceholder').style.display = 'block';
    document.getElementById('cvCardPhotoImg').style.display = 'none';
    document.getElementById('cvCardPhotoPlaceholder').style.display = 'inline';
    updateStatus('photo', false, '');
  } else if (type === 'cv') {
    document.getElementById('cvInput').value = '';
    document.getElementById('cvPreview').classList.remove('visible');
    document.getElementById('cvCard').classList.remove('has-file');
    document.getElementById('visitorCvPreview').style.opacity = '.5';
    document.getElementById('visitorCvPreview').style.pointerEvents = 'none';
    document.getElementById('visitorCvDownload').style.opacity = '.5';
    document.getElementById('visitorCvDownload').style.pointerEvents = 'none';
    updateStatus('cv', false, '');
  } else if (type === 'award') {
    document.getElementById('awardInput').value = '';
    document.getElementById('awardPreview').classList.remove('visible');
  }
}

// ── STATUS TABLE ──
function updateStatus(key, uploaded, filename) {
  const dotEl = document.getElementById('st-' + key);
  const textEl = document.getElementById('st-' + key + '-text');
  if (!dotEl || !textEl) return;
  if (uploaded) {
    dotEl.className = 'status-dot ok';
    textEl.textContent = '✓ ' + filename;
    textEl.style.color = 'var(--green)';
  } else {
    dotEl.className = 'status-dot missing';
    textEl.textContent = 'Not uploaded';
    textEl.style.color = '';
  }
}

// ── DRAG & DROP ──
['photoZone', 'cvZone'].forEach(zoneId => {
  const zone = document.getElementById(zoneId);
  if (!zone) return;
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const inputId = zoneId === 'photoZone' ? 'photoInput' : 'cvInput';
    const input = document.getElementById(inputId);
    const files = e.dataTransfer.files;
    if (files.length) {
      const dt = new DataTransfer();
      dt.items.add(files[0]);
      input.files = dt.files;
      input.dispatchEvent(new Event('change'));
    }
  });
});
</script>
