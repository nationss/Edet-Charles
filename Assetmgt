  <!-- ── SECTION 5: FILE STATUS SUMMARY ── -->
  <div class="am-section">
    <div class="am-section-title">📊 File Status Summary</div>
    <div class="am-section-sub">Overview of all files and their upload status for your portfolio.</div>

    <div style="border-radius:var(--radius);background:var(--glass);border:1px solid var(--glass-border);overflow:hidden;">
      <table class="summary-table">
        <thead><tr><th>Asset</th><th>Type</th><th>Purpose</th><th>Status</th></tr></thead>
        <tbody id="statusTable">
          <tr><td>Profile Photo</td><td>Image</td><td>Hero & About sections</td><td><span class="status-dot missing" id="st-photo"></span><span id="st-photo-text">Not uploaded</span></td></tr>
          <tr><td>CV / Resume</td><td>PDF</td><td>Download CV button (all sections)</td><td><span class="status-dot missing" id="st-cv"></span><span id="st-cv-text">Not uploaded</span></td></tr>
          <tr><td>OAF Award Image</td><td>Image</td><td>Achievement section</td><td><span class="status-dot ok"></span>Embedded in portfolio</td></tr>
          <tr><td>Sales Analysis</td><td>Image/PDF</td><td>Portfolio card preview</td><td><span class="status-dot missing" id="st-doc-0"></span><span id="st-doc-text-0">Not uploaded</span></td></tr>
          <tr><td>Hospital Dashboard</td><td>Image/PDF</td><td>Portfolio card preview</td><td><span class="status-dot missing" id="st-doc-1"></span><span id="st-doc-text-1">Not uploaded</span></td></tr>
          <tr><td>Warehouse System</td><td>Image/PDF</td><td>Portfolio card preview</td><td><span class="status-dot missing" id="st-doc-2"></span><span id="st-doc-text-2">Not uploaded</span></td></tr>
          <tr><td>Financial Report</td><td>Image/PDF</td><td>Portfolio card preview</td><td><span class="status-dot missing" id="st-doc-3"></span><span id="st-doc-text-3">Not uploaded</span></td></tr>
          <tr><td>Audit Papers</td><td>Image/PDF</td><td>Portfolio card preview</td><td><span class="status-dot missing" id="st-doc-4"></span><span id="st-doc-text-4">Not uploaded</span></td></tr>
          <tr><td>Design Work</td><td>Image/PDF</td><td>Portfolio card preview</td><td><span class="status-dot missing" id="st-doc-5"></span><span id="st-doc-text-5">Not uploaded</span></td></tr>
